{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "lib": ["es2020"],
    "noImplicitAny": true,
    "noImplicitThis": true,
    "types": ["jest", "node"],
    "jsx": "react",
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {"react-native": ["."]},
    "moduleResolution": "bundler",
    "customConditions": ["react-native-strict-api"]
  },
  "include": ["tests/**/*.ts"],
  "exclude": []
}
